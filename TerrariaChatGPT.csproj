<Project Sdk="Microsoft.NET.Sdk">

	<!-- Import tModLoader mod properties -->
	<Import Project="..\tModLoader.targets" Condition="Exists('..\tModLoader.targets')" />
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AssemblyName>TerrariaChatGPT</AssemblyName>
    <RootNamespace>TerrariaGPT</RootNamespace>
    <TModLoaderDirectory Condition="'$(TModLoaderDirectory)' == ''">C:\Program Files (x86)\Steam\steamapps\common\tModLoader</TModLoaderDirectory>
  </PropertyGroup>
  <Import Project="$(TModLoaderDirectory)\tMLMod.targets" Condition="Exists('$(TModLoaderDirectory)\tMLMod.targets')" />
  <ItemGroup>
    <Compile Remove="tools\**;tests\**;.build\**" />
  </ItemGroup>
</Project>
